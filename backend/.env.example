# ===== Server =====
PORT=3000

# ===== Database (MySQL) =====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=uni_activity_db
DB_PORT=3306

# ===== JWT =====
JWT_SECRET=your_super_secret_key

# ===== Email Verification (Nodemailer - Gmail SMTP) =====
# ใช้ App Password ของ Gmail (ไม่ใช่รหัสผ่านจริง)
# สร้างได้ที่: Google Account > Security > 2-Step Verification > App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# ===== Frontend URL (สำหรับสร้างลิงก์ยืนยันอีเมล) =====
FRONTEND_URL=http://localhost:8080
